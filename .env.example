# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_PASSWORD: Set this before deploying to a real server / exposing the app
# beyond your own PC. When set, the UI will show a login screen and all /api
# requests require this password. Leave empty only for purely local single-PC use.
APP_PASSWORD=""

# PORT: Port the server listens on (default 3000).
PORT=3000

# HOST: Interface the server binds to. Use 127.0.0.1 to restrict access to
# this machine only, or 0.0.0.0 (default) when deploying on a server that
# should be reachable from other devices/reverse proxies.
HOST=0.0.0.0
