# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_USERNAME / ADMIN_PASSWORD: used only once, the very first time the
# server starts with an empty users database — creates the initial admin
# account. If ADMIN_PASSWORD is left empty, a random strong password is
# generated and printed to the server log (and saved once to
# data/INITIAL_ADMIN_PASSWORD.txt). Log in with that account and create the
# rest of your team's accounts from the "Users" panel — the app never shows
# any data to a visitor who hasn't logged in with a real account.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# LETSKEYS_API_KEY: (опціонально) API-ключ для синхронізації каталогу
# постачальника LetsKeys (https://letskeys.com). Використовується лише на
# сервері — фронтенд ніколи його не бачить. Без нього кнопка синхронізації
# в розділі "Постачальники" покаже помилку конфігурації.
LETSKEYS_API_KEY=""

# LETSKEYS_AUTO_SYNC_HOURS: (опціонально) якщо задано число більше 0 —
# сервер сам, у фоні, раз на стільки годин перевіряє ціни й наявність для
# всіх уже синхронізованих товарів LetsKeys і оновлює їх (з фіксацією
# історії цін). Без цього налаштування працює лише ручна синхронізація.
# Приклад: раз на 12 годин.
LETSKEYS_AUTO_SYNC_HOURS="12"

# PORT: Port the server listens on (default 3000).
PORT=3000

# HOST: Interface the server binds to. Use 127.0.0.1 to restrict access to
# this machine only, or 0.0.0.0 (default) when deploying on a server that
# should be reachable from other devices/reverse proxies.
HOST=0.0.0.0
